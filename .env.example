# Core
APP_ENV=production
DEMO_MODE=true
# BASE_URL can be omitted on Railway; RAILWAY_PUBLIC_DOMAIN is detected automatically.
# BASE_URL=https://your-domain.example
# SQLITE_PATH can be omitted when a Railway volume is attached; the app stores /<volume>/vowly.db automatically.

# Stripe (leave blank until you are ready to accept real payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_ULTIMATE_PRICE_ID=

# Resend (leave blank for invitation preview mode)
RESEND_API_KEY=
EMAIL_FROM=Vowly <onboarding@resend.dev>
